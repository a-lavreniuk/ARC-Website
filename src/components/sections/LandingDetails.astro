const sectionIds = ['collect', 'organize', 'search', 'view', 'more'];

---
{groups.map(({title, desc, items}, section) => (
  <section class:list={['landing-section', sectionIds[section]]} id={sectionIds[section]} data-examples={section === 1 || section === 3 ? "" : undefined} aria-labelledby={sectionIds[section] + '-title'}>
    <div class="section-inner">
      <header class="section-heading">
        <h2 id={sectionIds[section] + '-title'}>{section === 1 ? <>Наведите порядок так,<br />как вам удобно</> : title}</h2>
        <div class="section-summary">
          {section === 1 || section === 3 ? (
            <>
              <div class="example-tabs" role="group" aria-label={title}>
                {items.map((item, index) => (
                  <button type="button" data-example={index} aria-pressed={index === 0} aria-controls={sectionIds[section] + '-example-' + index}>
                    {item.title}<span class="tab-progress" aria-hidden="true"></span>
                  </button>
                ))}
              </div>
              <div class="example-descriptions">
                {items.map((item, index) => <p data-example-description hidden={index !== 0}>{item.body}</p>)}
              </div>
            </>
          ) : <p>{desc}</p>}
        </div>
      </header>
      {section === 1 || section === 3 ? (
        <div class="examples">
          <div class="examples-scroll">
            {items.map((item, index) => (
              <figure id={sectionIds[section] + '-example-' + index} data-example-panel hidden={index !== 0}>
                <img src={item.src} alt={item.title + ' в ARC'} width="1504" height="700" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      ) : (
        <div class:list={['cards', section === 0 ? 'stack' : 'bento']}>
          {items.map((item, index) => (
            <article class="example-card" style={`--step:${index}`}>
              {section === 0 ? <div class="scene-viewport" tabindex="0" aria-label={`Просмотр: ${item.title}`}><div class="scene-viewport__content">{index === 2 ? <CollectScreenshot /> : <CollectScenes kind={['import', 'extension', 'screenshot', 'auto'][index]} />}</div></div> : <img src={item.src} alt={item.title + ' в ARC'} loading="lazy" decoding="async" />}
              <div class="card-copy">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
))}
<section class="landing-section" id="faq" aria-labelledby="faq-title">
  <div class="section-inner">
    <header class="section-heading">
      <h2 id="faq-title">Остались вопросы?</h2>
      <p>Здесь собрали ответы на основные вопросы о ARC, его возможностях и работе с библиотекой. Если что-то осталось непонятно, <span class="faq-contact">напишите нам</span></p>
    </header>
    <div class="faq-list">
      {faq.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
    </div>
  </div>
</section>
<footer class="landing-section" id="footer">
  <div class="section-inner">
    <div class="closing">
      <h2>Попробуйте ARC</h2>
      <p>Оставьте заявку на участие в бета-тесте и получите ранний доступ к приложению. <br class="closing-break" />Участие бесплатно, а ваши отзывы помогают нам развивать продукт дальше.</p>
      <button class="button button--hero closing-cta" type="button"><span class="button--hero__background" aria-hidden="true"><span class="button--hero__fill"></span><span class="button--hero__fill button--hero__fill--dark"></span></span><span class="button--hero__inner" data-text="Записаться на&nbsp;бета-тест"><span class="button--hero__text">Записаться на&nbsp;бета-тест</span></span></button>
    </div>
    <div class="footer-details">
      <div><img class="footer-logo" src="/images/arc-logo.svg" alt="ARC" width="32" height="32" /><p>© 2026 Artist Reference Collection</p><p>Политика обработки персональных данных</p><p>Лицензионное соглашение</p></div>
      <div><h3>Для кого</h3><ul><li>Возможности и сравнение</li><li>Дизайнерам</li><li>Художникам</li><li>Фотографам</li><li>Иллюстраторам</li><li>Референсы для генерации</li></ul></div>
      <div><h3>ARC</h3><ul><li><a href="https://arc-app.gitbook.io/support">База знаний</a></li><li>Почта</li><li><a href="https://t.me/arc_app">Telegram</a></li><li>Instagram</li></ul></div>
      <div><h3>Системные требования</h3><p>Windows 10 или 11, 64-bit. Около 1 ГБ на диск плюс место под библиотеку.</p><h3 class="footer-ai-heading">Системные требования для AI моделей</h3><p>Минимальные: 2 ГБ оперативной памяти и около 350 МБ на диске. Лёгкий поиск работает без отдельной видеокарты.</p><p>Рекомендуемые: 12 ГБ оперативной памяти и NVIDIA с примерно 10 ГБ видеопамяти — тогда доступны качественный поиск и подписи к кадрам.</p></div>
    </div>
  </div>
</footer>
<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const scenes = document.querySelectorAll<HTMLElement>('.collect-scene, .capture-scene');
  const mobileScenes = window.matchMedia('(max-width: 767px)');
  const extensionScene = document.querySelector<HTMLElement>('.collect-scene.extension');
  if (extensionScene) {
    const pointer = extensionScene.querySelector<HTMLElement>('.extension-cursor');
    const cards = Array.from(extensionScene.querySelectorAll<HTMLElement>('.extension-card'));
    let current: HTMLElement | undefined;
    let widgetFrame = 0;
    const updateWidgets = () => {
      if (!extensionScene.classList.contains('scene-running')) { current?.classList.remove('widget-visible'); current = undefined; widgetFrame = 0; return; }
      if (pointer && extensionScene.classList.contains('scene-running') && getComputedStyle(pointer).opacity !== '0') {
        const rect = pointer.getBoundingClientRect();
        const x = rect.left + rect.width * .371;
        const y = rect.top + rect.height * .261;
        const hit = cards.find(card => { const box = card.getBoundingClientRect(); return x >= box.left && x <= box.right && y >= box.top && y <= box.bottom; });
        if (hit !== current) { current?.classList.remove('widget-visible'); hit?.classList.add('widget-visible'); current = hit; }
      } else if (current) { current.classList.remove('widget-visible'); current = undefined; }
      widgetFrame = requestAnimationFrame(updateWidgets);
    };
    new MutationObserver(() => { if (extensionScene.classList.contains('scene-running') && !widgetFrame) widgetFrame = requestAnimationFrame(updateWidgets); }).observe(extensionScene, { attributes: true, attributeFilter: ['class'] });
    if (extensionScene.classList.contains('scene-running')) widgetFrame = requestAnimationFrame(updateWidgets);
  }
  if ('IntersectionObserver' in window) {
    const visibleScenes = new Set<Element>();
    const syncScenes = () => scenes.forEach(scene => scene.classList.toggle('scene-running', visibleScenes.has(scene) && !document.hidden && !reducedMotion.matches && !mobileScenes.matches));
    const sceneObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) visibleScenes.add(entry.target); else visibleScenes.delete(entry.target); });
      syncScenes();
    }, { threshold: .55 });
    scenes.forEach(scene => sceneObserver.observe(scene));
    document.addEventListener('visibilitychange', syncScenes);
